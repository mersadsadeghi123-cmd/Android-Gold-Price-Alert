<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- انتخاب شده -->
    <item android:state_selected="true">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#C29A3A"
                android:centerColor="#E3C86F"
                android:endColor="#A97F25"/>
            <corners android:radius="13dp"/>
            <stroke
                android:width="1dp"
                android:color="#DCC575"/>
        </shape>
    </item>

    <!-- لمس -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#C29A3A"/>
            <corners android:radius="13dp"/>
            <stroke
                android:width="1dp"
                android:color="#D8C06A"/>
        </shape>
    </item>

    <!-- عادی -->
    <item>
        <shape>
            <solid android:color="#FFFDF6"/>
            <corners android:radius="13dp"/>
            <stroke
                android:width="1dp"
                android:color="#E5D9B8"/>
        </shape>
    </item>

</selector>
