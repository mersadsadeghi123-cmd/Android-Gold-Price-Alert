<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/mergold_widget_premium_bg"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="◆ mrgold"
            android:textColor="#E5C66B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/premiumWidgetStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● آنلاین"
            android:textColor="#75D6A0"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="قیمت طلای ۱۸ عیار"
        android:textColor="#A9A9B1"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/premiumWidgetPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:text="در حال دریافت..."
        android:textColor="#F5D778"
        android:textSize="25sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:contentDescription="قیمت طلای ۱۸ عیار" />

    <TextView
        android:id="@+id/premiumWidgetChange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="— بدون تغییر"
        android:textColor="#D5D5D9"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/premiumWidgetChart"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:scaleType="fitCenter"
        android:contentDescription="نمودار تغییر قیمت طلا" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="#3B3527" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/premiumWidgetSource"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="منبع: —"
            android:textColor="#A9A9B1"
            android:textSize="10sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/premiumWidgetLastUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#888991"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/premiumWidgetRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="7dp"
            android:paddingVertical="4dp"
            android:text="↻"
            android:textColor="#E5C66B"
            android:textSize="16sp"
            android:textStyle="bold"
            android:contentDescription="به‌روزرسانی قیمت" />
    </LinearLayout>
</LinearLayout>
