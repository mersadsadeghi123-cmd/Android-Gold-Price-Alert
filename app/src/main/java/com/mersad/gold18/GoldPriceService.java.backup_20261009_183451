    private long parsePrice(JSONObject json, String source)
            throws Exception {

        if ("topgold".equals(source)) {
            return json
                    .getJSONObject("data")
                    .getLong("price");
        }

        if ("melligold".equals(source)) {
            return json.getJSONObject("data").getLong("price_sell");
        }

        if ("milli".equals(source)) {
            return json
                    .getJSONObject("data")
                    .getLong("price18") * 100;
        }

        return json
                .getJSONObject("gold18")
                .getLong("price") * 100;
    }

    private void updateBackgroundNotification(
            long currentPrice,
            String source) {

        try {

            JSONArray history =
                    PriceHistory.get(
                            this,
                            source
                    );

            long highest = currentPrice;
            long lowest = currentPrice;
            long previous = currentPrice;

            for (int i = 0;
                 i < history.length();
                 i++) {

                JSONObject item =
                        history.getJSONObject(i);

                long value =
                        item.getLong("price");

                if (value > highest) {
                    highest = value;
                }

                if (value < lowest) {
                    lowest = value;
                }

                if (i ==
                        history.length() - 1) {

                    previous = value;
                }
            }

            long change =
                    currentPrice - previous;

            String changeText;

            if (change > 0) {

                changeText =
                        "🟢 ▲ +" +
                        formatPrice(change) +
                        " تومان";

            } else if (change < 0) {

                changeText =
                        "🔴 ▼ -" +
                        formatPrice(
                                Math.abs(change)
                        ) +
                        " تومان";

            } else {

                changeText =
                        "⚪ — بدون تغییر";
            }

            Intent openIntent =
                    new Intent(
                            this,
                            MainActivity.class
                    );

            openIntent.setFlags(
                    Intent.FLAG_ACTIVITY_SINGLE_TOP |
                    Intent.FLAG_ACTIVITY_CLEAR_TOP
            );

            PendingIntent pendingIntent =
                    PendingIntent.getActivity(
                            this,
                            1001,
                            openIntent,
                            PendingIntent.FLAG_UPDATE_CURRENT |
                            PendingIntent.FLAG_IMMUTABLE
                    );

            String title =
                    "MrGold • " +
                    sourceName(source) +
                    " • طلای ۱۸ عیار";

            SharedPreferences settings =
                    getSharedPreferences(
                            "gold_settings",
                            MODE_PRIVATE
                    );

            String highTarget =
                    settings.getString(
                            "high_target_" + source,
                            ""
                    );

            String lowTarget =
                    settings.getString(
                            "low_target_" + source,
                            ""
                    );

            boolean highEnabled =
                    settings.getBoolean(
                            "high_enabled_" + source,
                            true
                    );

            boolean lowEnabled =
                    settings.getBoolean(
                            "low_enabled_" + source,
                            true
                    );

            String targetText = "";

            if (highEnabled &&
                    !highTarget.isEmpty()) {

                targetText +=
                        "🔺 بالا: " +
                        highTarget +
                        " تومان";
            }

            if (lowEnabled &&
                    !lowTarget.isEmpty()) {

                if (!targetText.isEmpty()) {
                    targetText += "\n";
                }

                targetText +=
                        "🔻 پایین: " +
                        lowTarget +
                        " تومان";
            }

            String compactText =
                    "💰 " +
                    formatPrice(currentPrice) +
                    " تومان   " +
                    changeText;

            String details =
                    "💰 " +
                    formatPrice(currentPrice) +
                    " تومان\n" +
                    changeText;

            if (!targetText.isEmpty()) {
                details += "\n" + targetText;
            }

            Notification.Builder builder =
                    new Notification.Builder(
                            this,
                            CHANNEL_ID
                    )
                            .setSmallIcon(
                                    R.drawable.ic_notification_gold
                            )
                            .setContentTitle(title)
                            .setContentText(
                                    compactText
                            )
                            .setStyle(
                                    new Notification.BigTextStyle()
                                            .bigText(details)
                                            .setBigContentTitle(title)
                            )
                            .setContentIntent(
                                    pendingIntent
                            )
                            .setOngoing(true)
                            .setOnlyAlertOnce(true)
                            .setShowWhen(false)
                            .setCategory(
                                    Notification.CATEGORY_STATUS
                            )
                            .setVisibility(
                                    Notification.VISIBILITY_PUBLIC
                            )
                            .setColor(
                                    change > 0
                                            ? 0xFF2E7D32
                                            : change < 0
                                            ? 0xFFC62828
                                            : 0xFF757575
                            );

            NotificationManager manager =
                    (NotificationManager)
                            getSystemService(
                                    Context.NOTIFICATION_SERVICE
                            );

            if (manager != null) {

                manager.notify(
                        1001,
                        builder.build()
                );
            }

        } catch (Exception ignored) {
        }
    }

