    private void checkTargets(
            long price,
            String source) {

        SharedPreferences prefs =
                getSharedPreferences(
                        "gold_settings",
                        MODE_PRIVATE
                );

        String suffix =
                "_alerted_" + source;

        String highTargetKey =
                "high_target_" + source;

        String highEnabledKey =
                "high_enabled_" + source;

        String highTarget2Key =
                "high_target_2_" + source;

        String highEnabled2Key =
                "high_enabled_2_" + source;

        String lowTargetKey =
                "low_target_" + source;

        String lowEnabledKey =
                "low_enabled_" + source;

        String lowTarget2Key =
                "low_target_2_" + source;

        String lowEnabled2Key =
                "low_enabled_2_" + source;

        checkSingleTarget(
                prefs,
                price,
                highTargetKey,
                highEnabledKey,
                "high_alerted" + suffix,
                true,
                "🔺 هدف بالای طلا"
        );

        checkSingleTarget(
                prefs,
                price,
                highTarget2Key,
                highEnabled2Key,
                "high_alerted_2" + suffix,
                true,
                "🔺 هدف بالای طلا ۲"
        );

        checkSingleTarget(
                prefs,
                price,
                lowTargetKey,
                lowEnabledKey,
                "low_alerted" + suffix,
                false,
                "🔻 هدف پایین طلا"
        );

        checkSingleTarget(
                prefs,
                price,
                lowTarget2Key,
                lowEnabled2Key,
                "low_alerted_2" + suffix,
                false,
                "🔻 هدف پایین طلا ۲"
        );
    }

    private void checkSingleTarget(
            SharedPreferences prefs,
            long price,
            String targetKey,
            String enabledKey,
            String alertedKey,
            boolean isHigh,
            String title) {

        try {

            String targetText =
                    prefs.getString(
                            targetKey,
                            ""
                    );

            boolean enabled =
                    prefs.getBoolean(
                            enabledKey,
                            true
                    );

            boolean alerted =
                    prefs.getBoolean(
                            alertedKey,
                            false
                    );

            if (!enabled ||
                    targetText.isEmpty()) {

                return;
            }

            long target =
                    Long.parseLong(
                            targetText
                    );

            boolean reached =
                    isHigh
                            ? price >= target
                            : price <= target;

            if (reached && !alerted) {

                sendAlert(
                        title,
                        "قیمت به " +
                        formatPrice(price) +
                        " تومان رسید."
                );

                prefs.edit()
                        .putBoolean(
                                alertedKey,
                                true
                        )
                        .apply();

            } else if (!reached) {

                prefs.edit()
                        .putBoolean(
                                alertedKey,
                                false
                        )
                        .apply();
            }

        } catch (Exception ignored) {
        }
    }

    private double getRapidChangePercent(
            long currentPrice,
            String source) {

        try {

            JSONArray history =
                    PriceHistory.get(
                            this,
                            source
                    );

            if (history.length() == 0) {
                return 0.0;
            }

            long now =
                    System.currentTimeMillis();

            long cutoff =
                    now - RAPID_CHANGE_WINDOW;

            long referencePrice = 0;

            for (int i = history.length() - 1;
                 i >= 0;
                 i--) {

                JSONObject item =
                        history.getJSONObject(i);

                long time =
                        item.getLong("time");

                if (time <= cutoff) {

                    referencePrice =
                            item.getLong("price");

                    break;
                }
            }

            if (referencePrice <= 0) {
                return 0.0;
            }

            return (
                    (currentPrice - referencePrice)
                            * 100.0
            ) / referencePrice;

        } catch (Exception ignored) {

            return 0.0;
        }
    }

    private void createChannels() {

        if (Build.VERSION.SDK_INT >=
                Build.VERSION_CODES.O) {

            NotificationManager manager =
                    getSystemService(
                            NotificationManager.class
                    );

            NotificationChannel channel =
                    new NotificationChannel(
                            ALERT_CHANNEL_ID,
                            "هشدار قیمت طلا",
                            NotificationManager.IMPORTANCE_HIGH
                    );

            channel.setDescription(
                    "هشدار رسیدن قیمت طلا به اهداف تعیین‌شده"
            );

            manager.createNotificationChannel(
                    channel
            );

            NotificationChannel backgroundChannel =
                    new NotificationChannel(
                            CHANNEL_ID,
                            "رصد قیمت در پس‌زمینه",
                            NotificationManager.IMPORTANCE_LOW
                    );

            backgroundChannel.setDescription(
                    "نمایش قیمت لحظه‌ای طلا در پس‌زمینه"
            );

            manager.createNotificationChannel(
                    backgroundChannel
            );
        }
    }

    private String formatPrice(long price) {

        return String.format(
                Locale.US,
                "%,d",
                price
        );
    }

    private void sendAlert(
            String title,
            String message) {

        if (Build.VERSION.SDK_INT >= 33 &&
                checkSelfPermission(
                        Manifest.permission.POST_NOTIFICATIONS
                ) != PackageManager.PERMISSION_GRANTED) {

            return;
        }

        Notification notification =
                new Notification.Builder(
                        this,
                        ALERT_CHANNEL_ID
                )
                        .setSmallIcon(
                                R.drawable.ic_notification_gold
                        )
                        .setContentTitle(title)
                        .setContentText(message)
                        .setAutoCancel(true)
                        .setPriority(
                                Notification.PRIORITY_HIGH
                        )
                        .build();

        NotificationManager manager =
                (NotificationManager)
                        getSystemService(
                                Context.NOTIFICATION_SERVICE
                        );

        if (manager != null) {

            manager.notify(
                    (int)
                            System.currentTimeMillis(),
                    notification
            );
        }
    }

