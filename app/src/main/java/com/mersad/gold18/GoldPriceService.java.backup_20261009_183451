    private final Runnable checker =
            new Runnable() {

                @Override
                public void run() {

                    if (!checking) {
                        checkPrice();
                    }

                    handler.postDelayed(
                            this,
                            getInterval()
                    );
                }
            };

    @Override
    public int onStartCommand(Intent intent, int flags, int startId) {

        if (intent != null &&
                "com.mersad.gold18.WIDGET_REFRESH"
                        .equals(intent.getAction())) {

            checkPrice();
        }

        return START_STICKY;
    }

    @Override
    public void onTaskRemoved(Intent rootIntent) {
        super.onTaskRemoved(rootIntent);

        Intent restartService =
                new Intent(getApplicationContext(), GoldPriceService.class);

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            getApplicationContext().startForegroundService(restartService);
        } else {
            getApplicationContext().startService(restartService);
        }
    }

    @Override
    public void onCreate() {

        super.onCreate();

        createChannels();

        Intent openIntent =
                new Intent(
                        this,
                        MainActivity.class
                );

        openIntent.setFlags(
                Intent.FLAG_ACTIVITY_SINGLE_TOP |
                Intent.FLAG_ACTIVITY_CLEAR_TOP
        );

        PendingIntent pendingIntent =
                PendingIntent.getActivity(
                        this,
                        1001,
                        openIntent,
                        PendingIntent.FLAG_UPDATE_CURRENT |
                        PendingIntent.FLAG_IMMUTABLE
                );

        Notification notification =
                new Notification.Builder(
                        this,
                        CHANNEL_ID
                )
                        .setSmallIcon(
                                R.drawable.ic_notification_gold
                        )
                        .setContentTitle("MrGold")
                        .setContentText(
                                "رصد " +
                                getSourceName() +
                                " در پس‌زمینه فعال است"
                        )
                        .setContentIntent(
                                pendingIntent
                        )
                        .setOngoing(true)
                        .build();

        startForeground(
                1001,
                notification
        );

        handler.post(checker);
    }

    private void checkPrice() {

        if (checking) {
            return;
        }

        checking = true;

        new Thread(() -> {

            HttpURLConnection connection = null;

            try {

                final String requestSource =
                        getSource();

                final String requestUrl;

                if ("milli".equals(requestSource)) {
                    requestUrl = MILLI_API;
                } else if ("tgju".equals(requestSource)) {
                    requestUrl = TGJU_URL;
                } else if ("snappgold".equals(requestSource)) {
                    requestUrl = SNAPPGOLD_API;
                } else if ("topgold".equals(requestSource)) {
                    requestUrl = TOPGOLD_API;
                } else {
                    requestUrl = DIGIKALA_API;
                }

                URL url =
                        new URL(requestUrl);

                connection =
                        (HttpURLConnection)
                                url.openConnection();

                connection.setRequestMethod("GET");
                connection.setConnectTimeout(5000);
                connection.setReadTimeout(5000);
                connection.setUseCaches(false);

                BufferedReader reader =
                        new BufferedReader(
                                new InputStreamReader(
                                        connection.getInputStream()
                                )
                        );

                StringBuilder response =
                        new StringBuilder();

                String line;

                while ((line =
                        reader.readLine()) != null) {

                    response.append(line);
                }

                reader.close();

                String source =
                        requestSource;

                long price;

                if ("tgju".equals(source)) {

                    price =
                            parseTgjuHtml(response.toString());

                } else if ("snappgold".equals(source)) {

                    price = Long.parseLong(
                            response.toString().trim()
                    );

                } else {

                    JSONObject json =
                            new JSONObject(
                                    response.toString()
                            );

                    price =
                            parsePrice(json, source);
                }

                long now =
                        System.currentTimeMillis();

                if (now - lastHistorySave >= 60_000) {

                    PriceHistory.add(
                            this,
                            price,
                            source
                    );

                    lastHistorySave = now;
                }

                SharedPreferences widgetPrefs =
                        getSharedPreferences(
                                "gold_settings",
                                MODE_PRIVATE
                        );

                long oldWidgetPrice =
                        widgetPrefs.getLong(
                                "widget_price",
                                0
                        );

                long widgetChange =
                        oldWidgetPrice > 0
                                ? price - oldWidgetPrice
                                : 0;

                widgetPrefs.edit()
                        .putLong(
                                "widget_price",
                                price
                        )
                        .putLong(
                                "widget_change",
                                widgetChange
                        )
                        .putString(
                                "widget_source",
                                sourceName(source)
                        )
                        .putLong(
                                "widget_last_update",
                                now
                        )
                        .putBoolean(
                                "widget_online",
                                true
                        )
                        .apply();

                MerGoldWidget.updateWidgets(this);

                updateBackgroundNotification(
                        price,
                        source
                );

                double rapidChangePercent =
                        getRapidChangePercent(
                                price,
                                source
                        );

                SharedPreferences rapidPrefs =
                        getSharedPreferences(
                                "gold_settings",
                                MODE_PRIVATE
                        );

                rapidPrefs.edit()
                        .putString(
                                "rapid_change_percent_" + source,
                                Double.toString(rapidChangePercent)
                        )
                        .apply();

                String rapidAlertedKey =
                        "rapid_alerted_" + source;

                boolean rapidAlerted =
                        rapidPrefs.getBoolean(
                                rapidAlertedKey,
                                false
                        );

                if (Math.abs(rapidChangePercent)
                        >= RAPID_CHANGE_THRESHOLD) {

                    String rapidCooldownKey =
                            "rapid_alert_time_" + source;

                    long lastRapidAlert =
                            rapidPrefs.getLong(
                                    rapidCooldownKey,
                                    0
                            );

                    long nowRapidAlert =
                            System.currentTimeMillis();

                    boolean rapidCooldownActive =
                            lastRapidAlert > 0 &&
                            nowRapidAlert - lastRapidAlert
                                    < RAPID_ALERT_COOLDOWN;

                    if (!rapidCooldownActive) {

                        String rapidTitle =
                                rapidChangePercent > 0
                                        ? "افزایش سریع قیمت طلا"
                                        : "کاهش سریع قیمت طلا";

                        String rapidMessage =
                                "قیمت در ۵ دقیقه اخیر " +
                                String.format(
                                        Locale.US,
                                        "%.2f",
                                        Math.abs(rapidChangePercent)
                                ) +
                                "٪ " +
                                (rapidChangePercent > 0
                                        ? "افزایش"
                                        : "کاهش") +
                                " داشته است.";

                        sendAlert(
                                rapidTitle,
                                rapidMessage
                        );

                        rapidPrefs.edit()
                                .putBoolean(
                                        rapidAlertedKey,
                                        true
                                )
                                .putLong(
                                        rapidCooldownKey,
                                        nowRapidAlert
                                )
                                .apply();
                    }

                } else {

                    rapidPrefs.edit()
                            .putBoolean(
                                    rapidAlertedKey,
                                    false
                            )
                            .apply();
                }

                checkTargets(
                        price,
                        source
                );

            } catch (Exception ignored) {

            } finally {

                if (connection != null) {
                    connection.disconnect();
                }

                checking = false;
            }

        }).start();
    }

    private long fetchTgjuPrice(HttpURLConnection connection)
            throws Exception {

        BufferedReader reader =
                new BufferedReader(
                        new InputStreamReader(
                                connection.getInputStream()
                        )
                );

        StringBuilder html =
                new StringBuilder();

        String line;

        while ((line = reader.readLine()) != null) {
            html.append(line);
        }

        reader.close();

        String page = html.toString();

        String label =
                "<td class=\"text-right\">نرخ فعلی</td>";

        int labelIndex =
                page.indexOf(label);

        if (labelIndex == -1) {
            throw new Exception("TGJU current price label not found");
        }

        int valueStart =
                page.indexOf(
                        "<td class=\"text-left\">",
                        labelIndex
                );

        if (valueStart == -1) {
            throw new Exception("TGJU current price value not found");
        }

        valueStart +=
                "<td class=\"text-left\">".length();

        int valueEnd =
                page.indexOf(
                        "</td>",
                        valueStart
                );

        if (valueEnd == -1) {
            throw new Exception("TGJU current price end not found");
        }

        String priceText =
                page.substring(
                        valueStart,
                        valueEnd
                )
                .replace(",", "")
                .trim();

        return Long.parseLong(priceText) / 10;
    }

