<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#C29A3A"
                android:centerColor="#E3C86F"
                android:endColor="#A97F25"/>
            <corners android:radius="13dp"/>
            <stroke
                android:width="1dp"
                android:color="#E8CF78"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#735A24"/>
            <corners android:radius="13dp"/>
            <stroke
                android:width="1dp"
                android:color="#C29A3A"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#303030"/>
            <corners android:radius="13dp"/>
            <stroke
                android:width="1dp"
                android:color="#4A4437"/>
        </shape>
    </item>
</selector>
