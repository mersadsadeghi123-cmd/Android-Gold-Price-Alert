<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F3EF"
    android:layoutDirection="rtl"
    android:textDirection="rtl">

    <LinearLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="18dp"
        android:layoutDirection="rtl">

        <!-- هدر -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MrGold"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#C99A2E"
                android:gravity="center"
                android:letterSpacing="0.04"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="رصد طلای ۱۸ عیار"
                android:textSize="12sp"
                android:textColor="#8B8068"
                android:gravity="center"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- انتخاب منبع قیمت -->
        <LinearLayout
            android:id="@+id/sourceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="8dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/sourceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="منبع قیمت"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#303030"
                android:gravity="right"/>

            <RadioGroup
                android:id="@+id/sourceGroup"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layoutDirection="rtl">

                <RadioButton
                    android:id="@+id/digikalaRadio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="🛒 دیجی‌کالا"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:buttonTint="#B38B16"/>

                <RadioButton
                    android:id="@+id/milliRadio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="🪙 میلی"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:buttonTint="#B38B16"/>
            </RadioGroup>
        </LinearLayout>

        <!-- قیمت اصلی -->
        <LinearLayout
            android:id="@+id/priceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_gold"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="15dp"
            android:layout_marginBottom="10dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/priceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="قیمت لحظه‌ای طلای ۱۸ عیار"
                android:textSize="12sp"
                android:textColor="#766A4B"
                android:gravity="center"/>

            <TextView
                android:id="@+id/priceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="در حال دریافت قیمت..."
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="#9A7205"
                android:gravity="center"
                android:layout_marginTop="5dp"/>

            <TextView
                android:id="@+id/priceChangeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚪ — بدون تغییر"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="5dp"/>

            <TextView
                android:id="@+id/lastUpdateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="آخرین بروزرسانی: —"
                android:textSize="10sp"
                android:textColor="#81775E"
                android:gravity="center"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- نمودار -->
        <LinearLayout
            android:id="@+id/chartCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="8dp"
            android:layoutDirection="rtl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chartTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="نمودار قیمت"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#252525"
                    android:gravity="right"/>

                <TextView
                    android:id="@+id/chartStatsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="بیشترین: ---   کمترین: ---"
                    android:textSize="9sp"
                    android:textColor="#777777"
                    android:gravity="left"/>
            </LinearLayout>

            <com.mersad.gold18.PriceChartView
                android:id="@+id/chartView"
                android:layout_width="match_parent"
                android:layout_height="225dp"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- بازه نمودار -->
        <LinearLayout
            android:id="@+id/rangeLayout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#E9E7E0"
            android:padding="3dp"
            android:layout_marginBottom="10dp"
            android:layoutDirection="rtl">

            <Button
                android:id="@+id/dayButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="۲۴ ساعت"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp"/>

            <Button
                android:id="@+id/weekButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="هفتگی"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp"/>

            <Button
                android:id="@+id/monthButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ماهانه"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:minHeight="0dp"
                android:padding="0dp"/>
        </LinearLayout>

        <!-- کنترل‌های رصد -->
        <LinearLayout
            android:id="@+id/refreshCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_marginBottom="7dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/refreshTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="بروزرسانی قیمت"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#303030"
                android:gravity="right"/>

            <Spinner
                android:id="@+id/refreshSpinner"
                android:layout_width="125dp"
                android:layout_height="42dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/backgroundCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_white"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:layout_marginBottom="10dp"
            android:layoutDirection="rtl">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/backgroundTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="رصد پس‌زمینه"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#303030"
                    android:gravity="right"/>

                <TextView
                    android:id="@+id/backgroundStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🟢 رصد پس‌زمینه فعال"
                    android:textSize="9sp"
                    android:textColor="#5F7D35"
                    android:gravity="right"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <Spinner
                android:id="@+id/backgroundSpinner"
                android:layout_width="125dp"
                android:layout_height="42dp"/>
        </LinearLayout>

        <!-- مقدار طلا -->
        <LinearLayout
            android:id="@+id/amountCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="12dp"
            android:layout_marginBottom="10dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/amountLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ارزش طلای شما"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#292929"
                android:gravity="right"/>

            <EditText
                android:id="@+id/amountInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="مقدار به سوت؛ مثلاً ۵۰۰"
                android:inputType="numberDecimal"
                android:gravity="right"
                android:layout_marginTop="5dp"/>

            <TextView
                android:id="@+id/valueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ارزش طلا: ---"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:textColor="#B38B16"/>
        </LinearLayout>

        <!-- اهداف -->
        <TextView
            android:id="@+id/targetsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اهداف قیمت و هشدارها"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="right"
            android:textColor="#252525"
            android:paddingTop="2dp"
            android:paddingBottom="6dp"/>

        <!-- اهداف صعودی -->
        <LinearLayout
            android:id="@+id/highBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="12dp"
            android:layout_marginBottom="7dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/highTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▲ اهداف صعودی"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4F7E3A"
                android:gravity="right"/>

            <EditText
                android:id="@+id/highInput"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:hint="هدف صعودی ۱"
                android:inputType="number"
                android:gravity="right"
                android:layout_marginTop="4dp"/>

            <Switch
                android:id="@+id/highSwitch"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="هشدار هدف صعودی ۱"
                android:gravity="right"
                android:textDirection="rtl"/>

            <EditText
                android:id="@+id/highInput2"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:hint="هدف صعودی ۲"
                android:inputType="number"
                android:gravity="right"/>

            <Switch
                android:id="@+id/highSwitch2"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="هشدار هدف صعودی ۲"
                android:gravity="right"
                android:textDirection="rtl"/>
        </LinearLayout>

        <!-- اهداف نزولی -->
        <LinearLayout
            android:id="@+id/lowBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="12dp"
            android:layout_marginBottom="7dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/lowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▼ اهداف نزولی"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#A34A43"
                android:gravity="right"/>

            <EditText
                android:id="@+id/lowInput"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:hint="هدف نزولی ۱"
                android:inputType="number"
                android:gravity="right"
                android:layout_marginTop="4dp"/>

            <Switch
                android:id="@+id/lowSwitch"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="هشدار هدف نزولی ۱"
                android:gravity="right"
                android:textDirection="rtl"/>

            <EditText
                android:id="@+id/lowInput2"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:hint="هدف نزولی ۲"
                android:inputType="number"
                android:gravity="right"/>

            <Switch
                android:id="@+id/lowSwitch2"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="هشدار هدف نزولی ۲"
                android:gravity="right"
                android:textDirection="rtl"/>
        </LinearLayout>

        <!-- تنظیمات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="5dp">

            <Switch
                android:id="@+id/darkSwitch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="حالت تاریک"
                android:textSize="12sp"
                android:gravity="right"
                android:textDirection="rtl"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MrGold"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#B38B16"/>
        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="ذخیره تنظیمات"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_gold"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="آماده"
            android:textSize="10sp"
            android:gravity="center"
            android:textColor="#777777"
            android:paddingTop="2dp"
            android:paddingBottom="5dp"/>

    </LinearLayout>

</ScrollView>
