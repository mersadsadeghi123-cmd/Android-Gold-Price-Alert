<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F4EF"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/settingsRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ تنظیمات"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#303030"
            android:gravity="right"
            android:layout_marginBottom="14dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_white"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="فاصله بروزرسانی قیمت"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#303030"
                android:gravity="right"/>

            <Spinner
                android:id="@+id/settingsRefreshSpinner"
                android:layout_width="115dp"
                android:layout_height="40dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_white"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="رصد پس‌زمینه"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#303030"
                    android:gravity="right"/>

                <TextView
                    android:id="@+id/settingsBackgroundStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🟢 رصد پس‌زمینه فعال"
                    android:textSize="8sp"
                    android:textColor="#5F7D35"
                    android:gravity="right"
                    android:layout_marginTop="1dp"/>

            </LinearLayout>

            <Switch
                android:id="@+id/settingsBackgroundSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="فعال"
                android:textSize="9sp"
                android:layout_marginEnd="6dp"/>

            <Spinner
                android:id="@+id/settingsBackgroundSpinner"
                android:layout_width="115dp"
                android:layout_height="40dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_white"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="حالت تاریک"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#303030"
                android:gravity="right"/>

            <Switch
                android:id="@+id/settingsDarkSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="فعال"
                android:textSize="9sp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/settingsVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MrGold • تنظیمات برنامه"
            android:textSize="10sp"
            android:textColor="#777777"
            android:gravity="center"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

</ScrollView>
