<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="◆ mrgold"
            android:textColor="#FFD65A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/premiumWidgetStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● آنلاین"
            android:textColor="#55E69A"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="قیمت طلای ۱۸ عیار"
        android:textColor="#E0E5E9"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/premiumWidgetPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:text="در حال دریافت..."
        android:textColor="#FFD65A"
        android:textSize="25sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:contentDescription="قیمت طلای ۱۸ عیار" />

    <TextView
        android:id="@+id/premiumWidgetChange"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="— بدون تغییر"
        android:textColor="#D0DCE3"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/premiumWidgetChart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="50dp"
        android:layout_marginTop="4dp"
        android:scaleType="fitCenter"
        android:contentDescription="نمودار تغییر قیمت طلا" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/premiumWidgetSource"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="منبع: —"
            android:textColor="#E0E5E9"
            android:textSize="10sp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/premiumWidgetLastUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#D0D8DE"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/premiumWidgetRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="7dp"
            android:paddingVertical="4dp"
            android:text="↻"
            android:textColor="#FFD65A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:contentDescription="به‌روزرسانی قیمت" />
    </LinearLayout>
</LinearLayout>
