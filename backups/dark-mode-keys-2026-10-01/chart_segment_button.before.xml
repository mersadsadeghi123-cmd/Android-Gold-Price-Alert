<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#E4DCC5"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#FFFFFF"/>
            <corners android:radius="10dp"/>
            <stroke
                android:width="1dp"
                android:color="#E7E1D3"/>
        </shape>
    </item>

</selector>
