<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <shape>
            <solid android:color="#F6E9B8"/>
            <corners android:radius="11dp"/>
            <stroke
                android:width="1dp"
                android:color="#D5B95D"/>
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#EEE8D7"/>
            <corners android:radius="11dp"/>
            <stroke
                android:width="1dp"
                android:color="#DDD4B8"/>
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#F7F6F2"/>
            <corners android:radius="11dp"/>
            <stroke
                android:width="1dp"
                android:color="#E7E2D6"/>
        </shape>
    </item>

</selector>
