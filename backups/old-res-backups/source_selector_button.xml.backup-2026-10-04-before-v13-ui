<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- منبع انتخاب شده -->
    <item android:state_checked="true">
        <layer-list>

            <item android:top="3dp">
                <shape>
                    <solid android:color="#80600A"/>
                    <corners android:radius="11dp"/>
                </shape>
            </item>

            <item android:bottom="3dp">
                <shape>
                    <gradient
                        android:angle="90"
                        android:startColor="#D9B84A"
                        android:centerColor="#C69A25"
                        android:endColor="#A97B0F"/>
                    <corners android:radius="11dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="#E8CC72"/>
                </shape>
            </item>

        </layer-list>
    </item>

    <!-- هنگام لمس -->
    <item android:state_pressed="true">
        <layer-list>

            <item android:top="1dp">
                <shape>
                    <solid android:color="#80600A"/>
                    <corners android:radius="11dp"/>
                </shape>
            </item>

            <item android:bottom="1dp">
                <shape>
                    <gradient
                        android:angle="90"
                        android:startColor="#C39A27"
                        android:centerColor="#B88916"
                        android:endColor="#946A08"/>
                    <corners android:radius="11dp"/>
                </shape>
            </item>

        </layer-list>
    </item>

    <!-- حالت عادی -->
    <item>
        <layer-list>

            <item android:top="3dp">
                <shape>
                    <solid android:color="#80600A"/>
                    <corners android:radius="11dp"/>
                </shape>
            </item>

            <item android:bottom="3dp">
                <shape>
                    <gradient
                        android:angle="90"
                        android:startColor="#F4E7B2"
                        android:centerColor="#E6CF7A"
                        android:endColor="#C8A63A"/>
                    <corners android:radius="11dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="#E8CC72"/>
                </shape>
            </item>

        </layer-list>
    </item>

</selector>
