<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F4EF"
    android:layoutDirection="rtl">

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#F6F4EF"
        android:layoutDirection="rtl"
        android:textDirection="rtl">

    <LinearLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:layoutDirection="rtl">

        <!-- هدر -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:layoutDirection="rtl">

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@android:drawable/ic_menu_manage"
                android:contentDescription="تنظیمات"
                android:background="@android:color/transparent"
                android:padding="8dp"
                android:tint="#B88A16"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MrGold"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#B88A16"
                    android:gravity="center"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="رصد هوشمند طلای ۱۸ عیار"
                    android:textSize="12sp"
                    android:textColor="#8A806B"
                    android:gravity="center"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <Space
                android:layout_width="42dp"
                android:layout_height="42dp"/>

        </LinearLayout>

        <!-- صفحه رصد بازار -->
        <LinearLayout
            android:id="@+id/marketPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- کارت قیمت اصلی -->
        <LinearLayout
            android:id="@+id/priceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_gold"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp"
            android:layout_marginBottom="10dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/priceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="طلای ۱۸ عیار"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#756943"
                android:gravity="center"/>

            <TextView
                android:id="@+id/priceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="در حال دریافت قیمت..."
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#927006"
                android:gravity="center"
                android:layout_marginTop="5dp"/>

            <TextView
                android:id="@+id/priceChangeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚪ — بدون تغییر"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="5dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="منبع فعال: دیجی‌کالا"
                    android:textSize="10sp"
                    android:textColor="#756943"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/lastUpdateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  •  آخرین بروزرسانی: —"
                    android:textSize="10sp"
                    android:textColor="#81775E"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>

        <!-- انتخاب منبع -->
        <LinearLayout
            android:id="@+id/sourceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_white"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginBottom="9dp"
            android:layoutDirection="rtl">

            <RadioGroup
                android:id="@+id/sourceGroup"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:layoutDirection="rtl">

                <RadioButton
                    android:id="@+id/digikalaRadio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="دیجی‌کالا"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:buttonTint="#B38B16"/>

                <RadioButton
                    android:id="@+id/milliRadio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="میلی"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:buttonTint="#B38B16"/>

                <RadioButton
                    android:id="@+id/tgjuRadio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="TGJU"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:buttonTint="#B38B16"/>
<RadioButton
                    android:id="@+id/snappGoldRadio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="اسنپ‌گلد"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:buttonTint="#B38B16"/>

            </RadioGroup>

            <TextView
                android:id="@+id/sourceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="منبع:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingStart="4dp"
                android:paddingEnd="5dp"/>

        </LinearLayout>

        <!-- مقایسه لحظه‌ای منابع -->
        <LinearLayout
            android:id="@+id/comparisonCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="9dp"
            android:layoutDirection="rtl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="مقایسه قیمت‌ها"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#B88A16"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/digikalaCompareText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="دیجی‌کالا    در حال دریافت..."
                android:textSize="12sp"
                android:textColor="#333333"
                android:gravity="center"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"/>

            <TextView
                android:id="@+id/milliCompareText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="میلی    در حال دریافت..."
                android:textSize="12sp"
                android:textColor="#333333"
                android:gravity="center"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"/>

            <TextView
                android:id="@+id/snappGoldCompareText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اسنپ‌گلد    در حال دریافت..."
                android:textSize="12sp"
                android:textColor="#333333"
                android:gravity="center"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"/>

            <TextView
                android:id="@+id/tgjuCompareText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TGJU    در حال دریافت..."
                android:textSize="12sp"
                android:textColor="#333333"
                android:gravity="center"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E1D7"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/marketDiffText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اختلاف بازار: —"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#756943"
                android:gravity="center"/>

        </LinearLayout>

        <!-- آمار -->
        <LinearLayout
            android:id="@+id/statsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_white"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="9dp"
            android:layoutDirection="rtl">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="بیشترین"
                    android:textSize="11sp"
                    android:textColor="#777777"/>

                <TextView
                    android:id="@+id/highestText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#4F7E3A"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="38dp"
                android:background="#E5E1D7"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="کمترین"
                    android:textSize="11sp"
                    android:textColor="#777777"/>

                <TextView
                    android:id="@+id/lowestText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#A34A43"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- نمودار -->
        <LinearLayout
            android:id="@+id/chartCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="7dp"
            android:layoutDirection="rtl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layoutDirection="rtl">

                

                <TextView
                    android:id="@+id/chartStatsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="بیشترین: ---   کمترین: ---"
                    android:textSize="8sp"
                    android:textColor="#777777"
                    android:gravity="left"/>

            </LinearLayout>

            <com.mersad.gold18.PriceChartView
                android:id="@+id/chartView"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/smartAnalysisText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="🧠 تحلیل بازه: ---"
                android:textSize="10sp"
                android:textColor="#555555"
                android:gravity="right"
                android:padding="6dp"/>

            <LinearLayout
                android:id="@+id/rangeLayout"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="#F0EEE8"
                android:padding="3dp"
                android:layout_marginTop="7dp"
                android:layoutDirection="rtl">

                <Button
                    android:id="@+id/dayButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="۱ ساعت"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/weekButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="۶ ساعت"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/monthButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="۲۴ ساعت"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp"/>

                <Button
                    android:id="@+id/days7Button"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="۷ روز"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:padding="0dp"/>

            </LinearLayout>

        </LinearLayout>

        </LinearLayout>

        <!-- صفحه ابزارها -->
        <LinearLayout
            android:id="@+id/toolsPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <!-- اهداف قیمت -->
        <TextView
            android:id="@+id/targetsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 اهداف قیمت و هشدارها"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="right"
            android:textColor="#252525"
            android:paddingTop="5dp"
            android:paddingBottom="7dp"/>

        <LinearLayout
            android:id="@+id/highBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="11dp"
            android:layout_marginBottom="7dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/highTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▲ اهداف صعودی"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4F7E3A"
                android:gravity="right"/>

            <EditText
                android:id="@+id/highInput"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:hint="هدف صعودی ۱"
                android:inputType="number"
                android:gravity="right"
                android:layout_marginTop="4dp"/>

            <Switch
                android:id="@+id/highSwitch"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="هشدار هدف صعودی ۱"
                android:gravity="right"
                android:textDirection="rtl"/>

            <TextView
                android:id="@+id/highStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🟢 در انتظار رسیدن به هدف"
                android:textSize="12sp"
                android:textColor="#777777"
                android:gravity="right"
                android:textDirection="rtl"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/highInput2"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:hint="هدف صعودی ۲"
                android:inputType="number"
                android:gravity="right"/>

            <Switch
                android:id="@+id/highSwitch2"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="هشدار هدف صعودی ۲"
                android:gravity="right"
                android:textDirection="rtl"/>

            <TextView
                android:id="@+id/highStatus2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🟢 در انتظار رسیدن به هدف"
                android:textSize="12sp"
                android:textColor="#777777"
                android:gravity="right"
                android:textDirection="rtl"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lowBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white"
            android:padding="11dp"
            android:layout_marginBottom="7dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/lowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▼ اهداف نزولی"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#A34A43"
                android:gravity="right"/>

            <EditText
                android:id="@+id/lowInput"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:hint="هدف نزولی ۱"
                android:inputType="number"
                android:gravity="right"
                android:layout_marginTop="4dp"/>

            <Switch
                android:id="@+id/lowSwitch"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="هشدار هدف نزولی ۱"
                android:gravity="right"
                android:textDirection="rtl"/>

            <TextView
                android:id="@+id/lowStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🟢 در انتظار رسیدن به هدف"
                android:textSize="12sp"
                android:textColor="#777777"
                android:gravity="right"
                android:textDirection="rtl"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/lowInput2"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:hint="هدف نزولی ۲"
                android:inputType="number"
                android:gravity="right"/>

            <Switch
                android:id="@+id/lowSwitch2"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="هشدار هدف نزولی ۲"
                android:gravity="right"
                android:textDirection="rtl"/>

            <TextView
                android:id="@+id/lowStatus2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🟢 در انتظار رسیدن به هدف"
                android:textSize="12sp"
                android:textColor="#777777"
                android:gravity="right"
                android:textDirection="rtl"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"/>

        </LinearLayout>

        <!-- ارزش طلا -->
        <LinearLayout
            android:id="@+id/amountCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_white"
            android:padding="11dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="7dp"
            android:layoutDirection="rtl">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/amountLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ارزش طلای شما"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#292929"
                    android:gravity="right"/>

                <TextView
                    android:id="@+id/valueText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ارزش طلا: ---"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#B38B16"
                    android:gravity="right"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <EditText
                android:id="@+id/amountInput"
                android:layout_width="125dp"
                android:layout_height="44dp"
                android:hint="۱۰۰۰ میلی‌گرم"
                android:inputType="numberDecimal"
                android:gravity="center"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="ذخیره تنظیمات"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_gold"
            android:layout_marginBottom="5dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="آماده"
            android:textSize="9sp"
            android:gravity="center"
            android:textColor="#777777"
            android:paddingTop="2dp"
            android:paddingBottom="5dp"/>

    </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layoutDirection="rtl">

        <Button
            android:id="@+id/marketNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📊 رصد بازار"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:textColor="#B88A16"/>

        <Button
            android:id="@+id/toolsNavButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🧮 ابزارها"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:textColor="#777777"/>

    </LinearLayout>

</LinearLayout>
