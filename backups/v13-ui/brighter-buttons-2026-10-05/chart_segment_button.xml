<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- انتخاب شده -->
    <item android:state_selected="true">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#B88716"
                android:centerColor="#D4AF37"
                android:endColor="#8A650D"/>
            <corners android:radius="13dp"/>
            <stroke
                android:width="1dp"
                android:color="#E8CC72"/>
        </shape>
    </item>

    <!-- لمس -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#B88916"/>
            <corners android:radius="13dp"/>
            <stroke
                android:width="1dp"
                android:color="#D9B84A"/>
        </shape>
    </item>

    <!-- عادی -->
    <item>
        <shape>
            <solid android:color="#FFFDF6"/>
            <corners android:radius="13dp"/>
            <stroke
                android:width="1dp"
                android:color="#E5D9B8"/>
        </shape>
    </item>

</selector>
